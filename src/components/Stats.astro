---
import { stats } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}
const c = ui[Astro.props.lang];
const fmt = new Intl.NumberFormat(c.numberLocale);
---

<section class="on-night bg-night py-[clamp(64px,9vw,120px)] text-on-night" aria-labelledby="stats-title">
	<div class="wrap">
		<h2 id="stats-title" class="sr-only">{c.stats.heading}</h2>
		<!-- 2 columns: a rule before every even cell; 3 columns (ml+): a rule before cells 2-3, 5-6. -->
		<ul class="grid grid-cols-2 border-t border-line-night ml:grid-cols-3" data-counters>
			{
				stats.map((s, i) => (
					<li class="grid content-start gap-2 border-b border-line-night pt-[clamp(20px,3vw,36px)] pr-4 pb-[clamp(24px,3vw,40px)] max-ml:even:border-l max-ml:even:pl-4 ml:[&:not(:nth-child(3n+1))]:border-l ml:[&:not(:nth-child(3n+1))]:pl-[clamp(20px,3vw,40px)]">
						<p class="font-serif text-stat whitespace-nowrap tabular-nums lining-nums">
							<span data-count={s.value}>{fmt.format(s.value)}</span>
							{s.suffix && <span class="ml-[0.04em] text-moss">{s.suffix}</span>}
						</p>
						<p class="max-w-[22ch] text-[clamp(0.9375rem,1.2vw,1.0625rem)] leading-[1.4] text-on-night-2">
							{c.stats.labels[i]}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
