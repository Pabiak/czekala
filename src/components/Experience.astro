---
import { Image } from 'astro:assets';
import plant from '../assets/czekala3.webp';
import { ui, routes, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].experience;
---

<section id={routes[lang].anchors.experience} class="py-(--section-y)" aria-labelledby="exp-title">
	<div class="wrap">
		<header class="mb-[clamp(40px,6vw,72px)] grid gap-4" data-reveal>
			<h2 id="exp-title" class="text-h2">{t.heading}</h2>
		</header>

		<div class="grid gap-12 lg:grid-cols-12 lg:gap-6">
			<div
				class="grid content-start gap-8 lg:sticky lg:top-[calc(var(--nav-h)+32px)] lg:col-span-4 lg:self-start"
				data-reveal
			>
				<blockquote>
					<p
						class="font-serif text-[clamp(1.75rem,3.2vw,2.5rem)] leading-[1.15] tracking-[-0.02em] text-balance text-forest-ink italic"
					>
						{t.quote}
					</p>
				</blockquote>
				<figure class="aspect-3/2 overflow-hidden rounded-md bg-paper-2 lg:aspect-4/5">
					<Image
						src={plant}
						alt={t.alt}
						widths={[360, 540, 768]}
						sizes="(min-width: 1024px) 34vw, 100vw"
						quality={74}
						class="size-full object-cover object-[60%_45%]"
					/>
				</figure>
			</div>

			<ol class="border-t border-line-strong lg:col-start-6 lg:col-end-13">
				{
					t.items.map((it, i) => (
						<li
							class="grid gap-2 border-b border-line py-7 sm:grid-cols-[9rem_1fr] sm:gap-6"
							data-reveal
							style={`--d: ${i * 60}ms`}
						>
							<p class="font-serif text-[1.75rem] leading-none tracking-[-0.02em] text-forest">{it.marker}</p>
							<div>
								<h3 class="mb-2 font-sans text-[1.1875rem] leading-[1.3] font-semibold tracking-normal">{it.title}</h3>
								<p class="max-w-[60ch] text-ink-2">{it.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>
