---
import { Image } from 'astro:assets';
import talk from '../assets/czekala1.jpg';
import { ui, routes, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].about;
---

<section id={routes[lang].anchors.about} class="py-(--section-y)" aria-labelledby="about-title">
	<div class="wrap">
		<header class="mb-[clamp(40px,6vw,72px)] grid gap-4" data-reveal>
			<h2 id="about-title" class="text-h2">{t.heading}</h2>
		</header>

		<div class="grid gap-10 lg:grid-cols-12 lg:gap-6">
			<div class="grid content-start gap-6 lg:col-span-6 lg:pr-6" data-reveal>
				<h3 class="text-2xl">{t.areasHeading}</h3>
				<p class="max-w-[40ch] text-lead text-ink-2">{t.lead}</p>
				<ul class="mt-2 flex flex-wrap gap-2" aria-label={t.areasHeading}>
					{
						t.areas.map((a) => (
							<li class="rounded-full border border-line-strong px-3.5 py-1.5 text-[0.9375rem] leading-[1.4]">{a}</li>
						))
					}
				</ul>
			</div>

			<figure
				class="aspect-4/3 overflow-hidden rounded-md bg-paper-2 lg:col-start-7 lg:col-end-13"
				data-reveal
				style="--d: 80ms"
			>
				<Image
					src={talk}
					alt={t.alt}
					width={1200}
					widths={[480, 720, 960, 1200]}
					sizes="(min-width: 1024px) 42vw, 100vw"
					quality={72}
					class="size-full object-cover object-[55%_30%]"
				/>
			</figure>
		</div>

		<aside
			class="mt-[clamp(56px,8vw,104px)] grid gap-4 border-t border-line-strong pt-[clamp(32px,4vw,48px)] lg:grid-cols-12 lg:items-end lg:gap-x-6"
			data-reveal
			aria-label={t.titleLabel}
		>
			<p class="text-[0.9375rem] font-medium text-forest lg:col-span-full">{t.titleKicker}</p>
			<p class="font-serif text-big text-balance lg:col-span-7">
				{t.titleBig.before}<span class="text-forest italic">{t.titleBig.num}</span>{t.titleBig.after}
			</p>
			<p class="max-w-[60ch] text-ink-2 lg:col-start-8 lg:col-end-13">{t.titleText}</p>
		</aside>
	</div>
</section>
