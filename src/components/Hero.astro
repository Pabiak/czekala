---
import { Image } from 'astro:assets';
import stage from '../assets/czekala2.jpeg';
import { contact } from '../data/site';
import { ui, type Lang } from '../i18n/ui';
import Arrow from './Arrow.astro';

interface Props {
	lang: Lang;
}
const t = ui[Astro.props.lang].hero;
---

<section
	class="pt-[clamp(24px,5vw,56px)] pb-[clamp(56px,8vw,104px)] lg:pt-[clamp(40px,5vw,72px)]"
	aria-labelledby="hero-title"
>
	<div
		class="wrap grid gap-10 lg:min-h-[min(760px,calc(100svh-var(--nav-h)-120px))] lg:grid-cols-12 lg:gap-x-6 lg:gap-y-0"
	>
		<div class="grid content-center gap-5 lg:col-span-6 lg:pr-6">
			<h1 id="hero-title" class="text-display" data-enter>{t.title}</h1>
			<p class="font-serif text-[clamp(1.375rem,2.4vw,1.875rem)] leading-[1.2]" data-enter style="--d: 120ms">
				{t.sub}
			</p>
			<p class="max-w-[44ch] text-ink-2" data-enter style="--d: 160ms">
				<strong class="font-semibold text-ink">Prof. Wojciech Czekała</strong> – {t.lead}
			</p>
			<div class="mt-3 flex flex-wrap gap-3" data-enter style="--d: 220ms">
				<a class="btn btn-primary max-xs:w-full" href={`mailto:${contact.email}`}>
					{t.email} <Arrow />
				</a>
				<a class="btn btn-ghost max-xs:w-full" href={contact.phoneHref}>{t.call} {contact.phone}</a>
			</div>
		</div>

		<figure
			class="relative aspect-4/3 overflow-hidden rounded-md bg-paper-2 lg:col-start-7 lg:col-end-13 lg:aspect-auto"
			data-enter
			style="--d: 100ms"
		>
			<Image
				src={stage}
				alt={t.alt}
				width={1600}
				widths={[480, 720, 960, 1280, 1600]}
				sizes="(min-width: 1024px) 50vw, 100vw"
				loading="eager"
				fetchpriority="high"
				quality={72}
				class="size-full object-cover object-[30%_30%]"
			/>
		</figure>
	</div>
</section>
