---
import { ui, routes, type Lang } from '../i18n/ui';
import Arrow from './Arrow.astro';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].collab;
const r = routes[lang];
const plural = new Intl.PluralRules(ui[lang].numberLocale);
const countLabel = (n: number) => t.countForms[plural.select(n)] ?? t.countForms.other;
---

<!--
  Expert positioning, deliberately not a sales page (client's explicit wish, to avoid a conflict
  of interest with his university): no prices, no hard sell, a soft link to contact.
  Two parts: a forest band with the statement, then the areas of collaboration on paper.
-->
<section id={r.anchors.collab} aria-labelledby="collab-title">
	<div class="on-night bg-forest py-(--section-y) text-paper-3">
		<div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-6">
			<div class="grid content-start gap-6 lg:col-span-7" data-reveal>
				<h2 id="collab-title" class="text-h2">{t.heading}</h2>
				<p class="font-serif text-[clamp(1.5rem,2.6vw,2.125rem)] leading-[1.25] tracking-[-0.015em] text-balance">
					{t.lead}
				</p>
			</div>
			<div class="grid content-end gap-5 lg:col-start-9 lg:col-end-13" data-reveal style="--d: 80ms">
				<p class="text-paper-3/86">{t.text}</p>
				<p class="text-paper-3/86">{t.invite}</p>
				<a
					class="mt-1 inline-flex min-h-11 items-center gap-2 justify-self-start font-medium text-paper-3 underline decoration-paper-3/40 decoration-1 underline-offset-[6px] transition-colors duration-200 ease-out hover:decoration-paper-3 [&_.arrow]:transition-transform [&_.arrow]:duration-200 [&_.arrow]:ease-out hover:[&_.arrow]:translate-x-[3px]"
					href={`#${r.anchors.contact}`}
				>
					{t.cta} <Arrow />
				</a>
			</div>
		</div>
	</div>

	<div class="bg-paper-2 py-(--section-y)">
		<div class="wrap">
			<p class="mb-[clamp(40px,6vw,72px)] max-w-[44ch] text-lead text-ink-2" data-reveal>{t.intro}</p>

			<!-- Native disclosure panels: no JS, content stays in the HTML for search engines and
			     find-in-page; `name` makes them exclusive so the section never unfolds to full length. -->
			<div class="border-t border-line-strong">
				{
					t.groups.map((g, i) => (
						<details class="collab-acc group/acc border-b border-line-strong" name="collab-areas" data-reveal style={`--d: ${i * 60}ms`}>
							<summary class="flex min-h-11 cursor-pointer list-none items-center gap-4 py-5 md:py-7 [&::-webkit-details-marker]:hidden">
								<h3 class="grow text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.1]">{g.title}</h3>
								<span class="hidden text-[0.9375rem] text-ink-2 sm:inline">
									{g.items.length} {countLabel(g.items.length)}
								</span>
								<span
									class="relative grid size-11 shrink-0 place-items-center rounded-full border border-line-strong text-ink transition-[background-color,border-color,color] duration-200 ease-out group-hover/acc:border-ink group-open/acc:border-forest group-open/acc:bg-forest group-open/acc:text-paper-3"
									aria-hidden="true"
								>
									<span class="absolute h-px w-3.5 bg-current" />
									<span class="absolute h-3.5 w-px bg-current transition-transform duration-240 ease-out group-open/acc:scale-y-0" />
								</span>
							</summary>
							<dl class="grid gap-x-10 gap-y-5 pb-8 md:grid-cols-2 md:gap-y-7 md:pb-10 lg:pl-[calc((100%+24px)/3)]">
								{g.items.map((item) => (
									<div class="grid content-start gap-1.5">
										<dt class="leading-[1.35] font-semibold text-ink">{item.title}</dt>
										<dd class="text-[0.9375rem] leading-[1.55] text-ink-2">{item.desc}</dd>
									</div>
								))}
							</dl>
						</details>
					))
				}
			</div>

			<p
				class="mt-[clamp(32px,5vw,56px)] text-[0.9375rem] leading-[1.55] text-ink-2"
				data-reveal
			>
				<span class="block max-w-[90ch]">{t.note}</span>
			</p>
		</div>
	</div>
</section>
