---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import portrait from '../../assets/wojciech-header.png';
import {
	getPosts,
	imageUrl,
	imageSrcset,
	readingMinutes,
	renderBody,
	plainText,
	type Post,
} from '../../lib/sanity';
import { site, contact } from '../../data/site';
import { ui } from '../../i18n/ui';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
	post: Post;
}

const { post } = Astro.props;
const c = ui.pl;
const t = c.knowledge;
const path = `/baza-wiedzy/${post.slug}`;
const url = `${site.url}${path}`;
const date = new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
const minutes = readingMinutes(post.body);
const html = renderBody(post.body);
// Authors often reuse the opening sentences as the excerpt; don't print them twice.
const norm = (t: string) => t.replace(/\s+/g, ' ').trim().toLowerCase();
const showExcerpt = !!post.excerpt && !norm(plainText(post.body)).startsWith(norm(post.excerpt).slice(0, 80));

// Lead image: the width of the reading column, always cropped to 16:9 (Sanity honours the
// editor's hotspot), so a tall or square upload never fills the screen before the text.
const heroRatio = 16 / 9;
const heroW = 1400;
const heroH = Math.round(heroW / heroRatio);
const ogImage = post.mainImage?.asset
	? { url: imageUrl(post.mainImage, 1200, 630), width: 1200, height: 630, alt: post.mainImage.alt ?? post.title }
	: undefined;

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: post.title,
		description: post.excerpt,
		datePublished: post.publishedAt,
		dateModified: post.updatedAt,
		inLanguage: 'pl',
		url,
		mainEntityOfPage: url,
		author: { '@id': `${site.url}/#person` },
		publisher: { '@id': `${site.url}/#person` },
		...(ogImage ? { image: ogImage.url } : {}),
	},
];
---

<Layout
	lang="pl"
	path={path}
	title={post.seoTitle ?? `${post.title} – Wojciech Czekała`}
	description={post.excerpt}
	ogType="article"
	ogImage={ogImage}
	schema={schema}
>
	<Fragment slot="head">
		<meta property="article:published_time" content={post.publishedAt} />
		<meta property="article:modified_time" content={post.updatedAt} />
		<meta property="article:author" content="Wojciech Czekała" />
	</Fragment>

	<article class="pt-[clamp(32px,6vw,72px)] pb-(--section-y)" aria-labelledby="post-title">
		<div class="wrap">
			<header class="mx-auto grid max-w-176 gap-5">
				<a
					class="inline-flex min-h-11 items-center gap-2 justify-self-start text-[0.9375rem] font-medium text-forest-ink"
					href="/baza-wiedzy"><Arrow direction="left" /> <span class="link">{t.back}</span></a
				>
				<h1 id="post-title" class="text-[clamp(2.5rem,6vw,4.25rem)] leading-[1.04] tracking-[-0.03em]" data-enter>
					{post.title}
				</h1>
				<p class="flex flex-wrap gap-x-3 gap-y-1 text-[0.9375rem] text-ink-2" data-enter style="--d: 60ms">
					<span class="font-semibold text-ink">Prof. Wojciech Czekała</span>
					<span aria-hidden="true">·</span>
					<time datetime={post.publishedAt}>{date.format(new Date(post.publishedAt))}</time>
					<span aria-hidden="true">·</span>
					<span>{minutes} {t.minutes}</span>
				</p>
				{
					showExcerpt && (
						<p class="text-lead text-ink-2" data-enter style="--d: 100ms">
							{post.excerpt}
						</p>
					)
				}
			</header>

			{
				post.mainImage?.asset && (
					<figure class="mx-auto mt-[clamp(28px,4vw,44px)] max-w-176" data-enter style="--d: 140ms">
						<img
							src={imageUrl(post.mainImage, heroW, heroH)}
							srcset={imageSrcset(post.mainImage, [480, 700, 1050, 1400], heroRatio)}
							sizes="(min-width: 784px) 704px, 100vw"
							alt={post.mainImage.alt ?? ''}
							width={heroW}
							height={heroH}
							loading="eager"
							fetchpriority="high"
							decoding="async"
							class="aspect-video w-full rounded-md bg-paper-2 object-cover"
						/>
						{post.mainImage.caption && (
							<figcaption class="mt-3 text-[0.9375rem] text-ink-2">{post.mainImage.caption}</figcaption>
						)}
					</figure>
				)
			}

			<div class="prose-czekala mx-auto mt-[clamp(40px,6vw,64px)] max-w-176" set:html={html} />

			<aside
				class="mx-auto mt-[clamp(56px,8vw,96px)] grid max-w-176 gap-6 border-t border-line-strong pt-8 sm:grid-cols-[120px_1fr] sm:items-start"
				aria-labelledby="author-title"
			>
				<div class="size-24 overflow-hidden rounded-full bg-paper-2 sm:size-30">
					<Image
						src={portrait}
						alt=""
						widths={[120, 240]}
						sizes="120px"
						class="size-full object-cover object-[50%_10%]"
					/>
				</div>
				<div class="grid gap-3">
					<h2 id="author-title" class="text-label font-sans font-semibold tracking-[0.12em] text-forest uppercase">
						{t.authorHeading}
					</h2>
					<p class="font-serif text-[1.75rem] leading-[1.15]">Prof. Wojciech Czekała</p>
					<p class="text-ink-2">{c.hero.lead.charAt(0).toUpperCase() + c.hero.lead.slice(1)}</p>
					<div class="mt-2 flex flex-wrap gap-3">
						<a class="btn btn-primary" href={`mailto:${contact.email}`}>{t.contactCta} <Arrow /></a>
						<a class="btn btn-ghost" href="/#o-mnie">{c.nav.about}</a>
					</div>
				</div>
			</aside>
		</div>
	</article>
</Layout>
